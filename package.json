{
  "name": "@forgesworn/flock",
  "version": "0.2.0",
  "description": "Framework-free location-safety and trusted-circle protocol primitives for ForgeSworn applications.",
  "homepage": "https://github.com/forgesworn/flock-kit#readme",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geofence": {
      "types": "./dist/geofence.d.ts",
      "import": "./dist/geofence.js"
    },
    "./noreport": {
      "types": "./dist/noreport.d.ts",
      "import": "./dist/noreport.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./signals": {
      "types": "./dist/signals.d.ts",
      "import": "./dist/signals.js"
    },
    "./nightout": {
      "types": "./dist/nightout.d.ts",
      "import": "./dist/nightout.js"
    },
    "./checkin": {
      "types": "./dist/checkin.d.ts",
      "import": "./dist/checkin.js"
    },
    "./trail": {
      "types": "./dist/trail.d.ts",
      "import": "./dist/trail.js"
    },
    "./buzz": {
      "types": "./dist/buzz.d.ts",
      "import": "./dist/buzz.js"
    },
    "./allclear": {
      "types": "./dist/allclear.d.ts",
      "import": "./dist/allclear.js"
    },
    "./fences": {
      "types": "./dist/fences.d.ts",
      "import": "./dist/fences.js"
    },
    "./rendezvous": {
      "types": "./dist/rendezvous.d.ts",
      "import": "./dist/rendezvous.js"
    },
    "./meeting": {
      "types": "./dist/meeting.d.ts",
      "import": "./dist/meeting.js"
    },
    "./disband": {
      "types": "./dist/disband.d.ts",
      "import": "./dist/disband.js"
    },
    "./offgrid": {
      "types": "./dist/offgrid.d.ts",
      "import": "./dist/offgrid.js"
    },
    "./spokenverify": {
      "types": "./dist/spokenverify.d.ts",
      "import": "./dist/spokenverify.js"
    },
    "./joined": {
      "types": "./dist/joined.d.ts",
      "import": "./dist/joined.js"
    },
    "./lost": {
      "types": "./dist/lost.d.ts",
      "import": "./dist/lost.js"
    },
    "./findping": {
      "types": "./dist/findping.d.ts",
      "import": "./dist/findping.js"
    },
    "./radar": {
      "types": "./dist/radar.d.ts",
      "import": "./dist/radar.js"
    },
    "./radarSession": {
      "types": "./dist/radarSession.d.ts",
      "import": "./dist/radarSession.js"
    }
  },
  "files": [
    "dist/",
    "compatibility/v1/*.json",
    "FLOCK.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check:extraction && npm run test && npm run typecheck && npm run build && npm run smoke",
    "check:extraction": "node scripts/check-extraction.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "gen:vectors": "FLOCK_GEN_VECTORS=1 vitest run compatibility/v1/radar-generate.test.ts"
  },
  "keywords": [
    "flock",
    "group-safety",
    "location-sharing",
    "geofence",
    "duress",
    "coercion-resistance",
    "nostr",
    "privacy",
    "canary-kit",
    "spoken-token"
  ],
  "author": "forgesworn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgesworn/flock-kit.git"
  },
  "bugs": {
    "url": "https://github.com/forgesworn/flock-kit/issues"
  },
  "dependencies": {
    "canary-kit": "^2.11.0",
    "geohash-kit": "^1.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "globals": "^17.7.0",
    "nostr-tools": "^2.23.3",
    "nsec-tree": "^1.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
